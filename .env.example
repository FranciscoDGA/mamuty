# ============================================
# MAMUTY BARBEARIA - Variáveis de Ambiente
# Copie para .env.local e preencha os valores
# ============================================

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://mjyhlzajiijtyswaxyaz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Uazapi (WhatsApp) - Configure com os dados da sua instância Uazapi
# Obtenha no painel da Uazapi (ou seu servidor uazapiGO)
UAZAPI_BASE_URL=https://api.uazapi.com
UAZAPI_SESSION=mamuty
UAZAPI_TOKEN=YOUR_UAZAPI_TOKEN
UAZAPI_SECRET=
UAZAPI_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Z-API (WhatsApp Alternativo) - Configure com suas credenciais
# Obtenha em: https://z-api.io
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=YOUR_INSTANCE_ID
ZAPI_TOKEN=YOUR_TOKEN
ZAPI_SECURITY_KEY=YOUR_SECURITY_KEY

# Gemini AI (opcional - para Marcos com LLM real)
GEMINI_API_KEY=YOUR_GEMINI_KEY

# Segurança (recomendado para produção)
# Gere com: openssl rand -hex 32
CRON_SECRET=YOUR_CRON_SECRET

